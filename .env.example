# Stud.IP Credentials
USERNAME=your_username_here
PASSWORD=your_password_here

# Telegram Bot
TELEGRAM_TOKEN=123456789:ABCdefGHIjks...
ALLOWED_USER_IDS=12345678,87654321

# 2FA (Optional)
TOTP_SECRET=YOUR_SECRET_KEY_HERE

# Configuration
HEADLESS=true

# WhatsApp Integration
# WA_GROUP_ID is set automatically from within the bot (/status → 📱 WhatsApp →
# 🔍 Detect WA Groups → pick a group), not typed here — leave unset initially.
# WA_GROUP_ID=123456789-987654321@g.us
PORT=3838

STUDIP_ICAL_URL=https://elearning.uni-oldenburg.de/dispatch.php/ical/index/YOUR_ID_HERE

# OpenRouter (free-tier LLM used for voice command intent classification)
OPENROUTER_API_KEY=your_openrouter_key_here
OPENROUTER_MODEL=cohere/north-mini-code:free
OUTFIT_OPENROUTER_MODEL=nvidia/nemotron-3-ultra-550b-a55b:free

# GWDG / KISSKI academic AI service (free with an academic account; one
# shared quota of 2 requests/10 s, 400/day, 3000/month). When set, text
# tasks, outfit picks and clothing-photo tagging try GWDG first and fall
# back to OpenRouter / Cloudflare; it's also the free try-on fallback
# after Nano Banana. Request a key at https://kisski.gwdg.de
GWDG_API_KEY=your_gwdg_api_key_here
# GWDG_TEXT_MODEL=gemma-4-31b-it              # text tasks (voice intents, summaries, extraction, narration)
# GWDG_OUTFIT_MODEL=deepseek-v4-flash-0731    # daily outfit pick
# GWDG_VISION_MODEL=gemma-4-31b-it            # clothing-photo tagging, garment descriptions for the GWDG try-on

# OpenRouter free text-to-speech, used for "🔊 Listen" / read-my-daily-plan-aloud
OPENROUTER_TTS_MODEL=fish-audio/s2.1-pro-free:free
# OPENROUTER_TTS_VOICE= (leave unset - this model has no selectable voice)

# Weather (free, no key needed — Open-Meteo). Defaults to Uni Oldenburg's
# coordinates; only change these if deploying for a different campus.
WEATHER_LATITUDE=53.1435
WEATHER_LONGITUDE=8.2146

# "👔 My Wardrobe" daily outfit suggestion — free-tier providers only.
# Cloudflare Workers AI (vision tagging + FLUX.2 fallback try-on image;
# dashboard.cloudflare.com → AI → Workers AI, 10,000 free Neurons/day):
# fal.ai (paid, ~$0.075/image) — primary try-on provider when set, picked
# over the free options below after a live quality comparison. Get a key
# at fal.ai/dashboard/keys (pay-as-you-go, no subscription):
FAL_KEY=your_fal_ai_key_here
# FAL_GEMINI_TRYON_MODEL=fal-ai/nano-banana-2/edit   # primary try-on (Google Gemini image model); set empty to skip
# FAL_TRYON_MODEL=fal-ai/fashn/tryon/v1.6            # fallback try-on
CLOUDFLARE_ACCOUNT_ID=your_cloudflare_account_id_here
CLOUDFLARE_API_TOKEN=your_cloudflare_workers_ai_token_here
# CLOUDFLARE_VISION_MODEL=@cf/mistralai/mistral-small-3.1-24b-instruct
# CLOUDFLARE_IMAGE_MODEL=@cf/black-forest-labs/flux-2-dev
# Hugging Face Spaces for the try-on image (free, public) — HF_TOKEN is a
# free huggingface.co account token (Settings -> Access Tokens -> Read),
# effectively REQUIRED in practice: anonymous ZeroGPU quota runs out fast.
# HF_SPACE_VTON=levihsu/OOTDiffusion
# HF_SPACE_ACCESSORIES=black-forest-labs/FLUX.1-Kontext-Dev
HF_TOKEN=your_free_huggingface_read_token_here