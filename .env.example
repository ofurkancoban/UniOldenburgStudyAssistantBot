# Stud.IP Credentials
USERNAME=your_username_here
PASSWORD=your_password_here

# Telegram Bot
TELEGRAM_TOKEN=123456789:ABCdefGHIjks...
# Required: only these Telegram user IDs may use the bot and the /login Mini
# App. Left empty, everyone is rejected (the bot fails closed).
ALLOWED_USER_IDS=12345678,87654321

# 2FA (Optional)
TOTP_SECRET=YOUR_SECRET_KEY_HERE

# --- Stud.IP Authentication ---
# false (default, recommended): self-healing cookie session for everything.
# true: JSON:API requests (courses, files, messages, news) additionally carry
#   an OAuth2 bearer token. `python studip_oauth.py login` runs the consent
#   flow once and writes studip_oauth_tokens.json (encrypted, mode 0600).
#   The token is refreshed automatically; a rejected refresh token is deleted
#   and the bot falls back to the cookie session until you log in again.
#   HTML-only pages (course selection, forum) always use the cookie session.
USE_STUDIP_OAUTH=false
STUDIP_OAUTH_CLIENT_ID=1
# STUDIP_OAUTH_TOKEN_FILE=studip_oauth_tokens.json
# Encryption key for the cookies and OAuth tokens stored on disk. If unset, a
# random key is generated once into .vault_key (mode 0600, gitignored). Keep
# that file (or this value) when moving the bot: without it the stored
# session can't be decrypted and you simply log in again.
# SESSION_ENCRYPTION_KEY=your_long_random_secret

# Web login page / Telegram Mini App (`/login` in the bot)
# The bot proxies the real Uni Oldenburg SSO login through its own session,
# so the cookies land in the bot (a login in Telegram's in-app browser would
# stay in the browser sandbox). Access is limited to ALLOWED_USER_IDS via the
# signed Mini App data or a single-use link. See DEPLOY_LOGIN.md.
#
# LOGIN_PUBLIC_URL must be HTTPS for the Mini App to work. With Cloudflare in
# front of the VPS, point a hostname at the machine and set it here, e.g.
#   LOGIN_PUBLIC_URL=https://bot.example.com
# Leave it unset to fall back to plain-link mode over the LAN (HTTP, single-use
# token, 10 minute TTL) - fine for testing, useless outside your network.
# LOGIN_PUBLIC_URL=https://bot.example.com
# LOGIN_PORT=8899
# Interface the login server binds to. Default: 127.0.0.1 when
# LOGIN_PUBLIC_URL or CLOUDFLARE_TUNNEL is set, otherwise 0.0.0.0 (LAN mode).
# LOGIN_HOST=127.0.0.1

# Optional: set the Telegram menu button to the Mini App on startup.
# Requires an HTTPS URL (from LOGIN_PUBLIC_URL or the tunnel below).
# SET_MENU_BUTTON=true

# Cloudflare quick tunnel - no domain, no account, no open port. The bot runs
# `cloudflared tunnel --url http://127.0.0.1:8899` itself and picks the
# https://<random>.trycloudflare.com hostname out of its output. The hostname
# changes on every restart, which is fine: /login rebuilds its button from the
# live URL and the menu button is re-pointed automatically.
# Requires cloudflared on PATH. See DEPLOY_LOGIN.md.
# CLOUDFLARE_TUNNEL=quick

# Configuration
HEADLESS=true

# WhatsApp Integration
# WA_GROUP_ID is set automatically from within the bot (/status → 📱 WhatsApp →
# 🔍 Detect WA Groups → pick a group), not typed here — leave unset initially.
# WA_GROUP_ID=123456789-987654321@g.us
# Port of the local WhatsApp service. It only listens on 127.0.0.1 and
# requires a shared secret; the bot generates one per run and hands it to the
# service it starts. Set WA_SERVICE_TOKEN only if you run server.js yourself.
PORT=3838
# WA_SERVICE_TOKEN=

# OpenRouter (free-tier LLM used for voice command intent classification)
OPENROUTER_API_KEY=your_openrouter_key_here
OPENROUTER_MODEL=cohere/north-mini-code:free
OUTFIT_OPENROUTER_MODEL=nvidia/nemotron-3-ultra-550b-a55b:free

# GWDG / KISSKI academic AI service (free with an academic account; one
# shared quota of 2 requests/10 s, 400/day, 3000/month). When set, text
# tasks, outfit picks and clothing-photo tagging try GWDG first and fall
# back to OpenRouter / Cloudflare; it's also the free try-on fallback
# after Nano Banana. Request a key at https://kisski.gwdg.de
GWDG_API_KEY=your_gwdg_api_key_here
# GWDG_TEXT_MODEL=gemma-4-31b-it              # text tasks (voice intents, summaries, extraction, narration)
# GWDG_OUTFIT_MODEL=deepseek-v4-flash-0731    # daily outfit pick
# GWDG_VISION_MODEL=gemma-4-31b-it            # clothing-photo tagging, garment descriptions for the GWDG try-on
# GWDG_WHISPER_MODEL=whisper-large-v3         # voice note transcription
# GWDG_EMBEDDING_MODEL=e5-mistral-7b-instruct  # course material search index

# OpenRouter free text-to-speech, used for "🔊 Listen" / read-my-daily-plan-aloud
OPENROUTER_TTS_MODEL=fish-audio/s2.1-pro-free:free
# OPENROUTER_TTS_VOICE= (leave unset - this model has no selectable voice)

# Weather (free, no key needed — Open-Meteo). Defaults to Uni Oldenburg's
# coordinates; only change these if deploying for a different campus.
WEATHER_LATITUDE=53.1435
WEATHER_LONGITUDE=8.2146

# "👔 My Wardrobe" daily outfit suggestion — free-tier providers only.
# Cloudflare Workers AI (vision tagging + FLUX.2 fallback try-on image;
# dashboard.cloudflare.com → AI → Workers AI, 10,000 free Neurons/day):
# fal.ai (paid, ~$0.075/image) — primary try-on provider when set, picked
# over the free options below after a live quality comparison. Get a key
# at fal.ai/dashboard/keys (pay-as-you-go, no subscription):
FAL_KEY=your_fal_ai_key_here
# FAL_GEMINI_TRYON_MODEL=fal-ai/nano-banana-2/edit   # primary try-on (Google Gemini image model); set empty to skip
# FAL_TRYON_MODEL=fal-ai/fashn/tryon/v1.6            # fallback try-on
CLOUDFLARE_ACCOUNT_ID=your_cloudflare_account_id_here
CLOUDFLARE_API_TOKEN=your_cloudflare_workers_ai_token_here
# CLOUDFLARE_VISION_MODEL=@cf/mistralai/mistral-small-3.1-24b-instruct
# CLOUDFLARE_IMAGE_MODEL=@cf/black-forest-labs/flux-2-dev
# Hugging Face Spaces for the try-on image (free, public) — HF_TOKEN is a
# free huggingface.co account token (Settings -> Access Tokens -> Read),
# effectively REQUIRED in practice: anonymous ZeroGPU quota runs out fast.
# HF_SPACE_VTON=levihsu/OOTDiffusion
# HF_SPACE_ACCESSORIES=black-forest-labs/FLUX.1-Kontext-Dev
HF_TOKEN=your_free_huggingface_read_token_here