# Stud.IP Credentials
USERNAME=your_username_here
PASSWORD=your_password_here

# Telegram Bot
TELEGRAM_TOKEN=123456789:ABCdefGHIjks...
ALLOWED_USER_IDS=12345678,87654321

# 2FA (Optional)
TOTP_SECRET=YOUR_SECRET_KEY_HERE

# Configuration
HEADLESS=true

# WhatsApp Integration
# WA_GROUP_ID is set automatically from within the bot (/status → 📱 WhatsApp →
# 🔍 Detect WA Groups → pick a group), not typed here — leave unset initially.
# WA_GROUP_ID=123456789-987654321@g.us
PORT=3838

STUDIP_ICAL_URL=https://elearning.uni-oldenburg.de/dispatch.php/ical/index/YOUR_ID_HERE

# OpenRouter (free-tier LLM used for voice command intent classification)
OPENROUTER_API_KEY=your_openrouter_key_here
OPENROUTER_MODEL=cohere/north-mini-code:free

# OpenRouter free text-to-speech, used for "🔊 Listen" / read-my-daily-plan-aloud
OPENROUTER_TTS_MODEL=fish-audio/s2.1-pro-free:free
# OPENROUTER_TTS_VOICE= (leave unset - this model has no selectable voice)

# Weather (free, no key needed — Open-Meteo). Defaults to Uni Oldenburg's
# coordinates; only change these if deploying for a different campus.
WEATHER_LATITUDE=53.1435
WEATHER_LONGITUDE=8.2146

# "👔 My Wardrobe" daily outfit suggestion — free-tier providers only.
# Cloudflare Workers AI (vision tagging + FLUX.2 fallback try-on image;
# dashboard.cloudflare.com → AI → Workers AI, 10,000 free Neurons/day):
CLOUDFLARE_ACCOUNT_ID=your_cloudflare_account_id_here
CLOUDFLARE_API_TOKEN=your_cloudflare_workers_ai_token_here
# CLOUDFLARE_VISION_MODEL=@cf/mistral-small-3.1-24b-instruct
# CLOUDFLARE_IMAGE_MODEL=@cf/black-forest-labs/flux-2-dev
# Hugging Face Space for the primary try-on image (free, public, no token
# strictly required — HF_TOKEN only raises the Space's rate limit):
# HF_SPACE_VTON=yisol/IDM-VTON
# HF_TOKEN=